#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
IMPORTABLE EXTERNPROTO "../protos/BrickDrone.proto"
IMPORTABLE EXTERNPROTO "../protos/BrickStill.proto"
IMPORTABLE EXTERNPROTO "../protos/BrickPhy.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/robots/dji/mavic/protos/Mavic2Pro.proto"

WorldInfo {
  info [
    "A simulation of a drone swarm capable of assembling structures out of bricks."
  ]
  title "Aerial Brick by Brick"
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
Viewpoint {
  orientation 0.1408520852217339 0.38970714918681865 -0.9101038555908727 0.6810298610969417
  position -7.606217332698849 6.441429270225551 2.0497937700273967
  follow "robot"
  followType "None"
}
RectangleArena {
  floorSize 16 16
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Robot {
  name "Brick Manager"
  controller "brick_spawner"
  supervisor TRUE
}
Robot {
  name "Drone Spawner"
  controller "drone_spawner"
  supervisor TRUE
}
